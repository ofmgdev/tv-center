# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Fallback poster/banner search when TMDb has no match for a show.
# 1. API key:   https://console.cloud.google.com/apis/credentials (enable "Custom Search API")
# 2. Search engine ID: https://programmablesearchengine.google.com/
#    - create a search engine -> "Search the entire web" -> turn ON "Image search"
# Free tier: 100 queries/day.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Folder where your TV show files live
MEDIA_ROOT=C:\Path\To\Your\TV Shows

# Path to shared SQLite database (default is fine)
DB_PATH=../data/db.sqlite
