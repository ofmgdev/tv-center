{
  "name": "tv-center",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted, Netflix-style library for your own downloaded TV shows.",
  "author": "ofmgdev",
  "main": "main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "start": "npm run build:renderer && electron .",
    "dev": "electron .",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "^4.21.2",
    "parse-torrent-title": "^3.0.1"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.ofmg.tvcenter",
    "productName": "TV Center",
    "directories": { "output": "release" },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "welcome.html",
      "lib/**/*",
      "renderer/**/*"
    ],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
