# Dependencies
node_modules/
server/node_modules/
frontend/node_modules/
desktop/node_modules/

# Python
python/venv/
python/__pycache__/
**/__pycache__/
*.pyc

# Build output
server/dist/
frontend/dist/

# Secrets (contains your TMDb/Google API keys)
python/.env

# Local database (generated by the scanner, not source code)
data/*.sqlite
data/*.sqlite-journal
data/config.json

# Logs
*.log
server/server.log
frontend/frontend.log

# Local test media (large binary files don't belong in git)
media_test/
